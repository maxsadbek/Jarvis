# JARVIS AI Assistant - Environment Configuration
# Copy this to .env and fill in your values

# --- Application ---
APP_NAME=JARVIS
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- OpenRouter LLM (Required for AI) ---
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=anthropic/claude-3-haiku
OPENROUTER_SITE_NAME=JARVIS

# --- Local LLM (Optional, fallback) ---
USE_LOCAL_LLM=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Voice - Speech to Text ---
STT_ENGINE=faster_whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto

# --- Voice - Text to Speech ---
TTS_ENGINE=piper
PIPER_VOICE_MODEL=en_US-lessac-medium
TTS_SPEED=1.0

# --- Wake Word ---
WAKE_WORD_ENABLED=true
WAKE_WORD=jarvis
WAKE_WORD_SENSITIVITY=0.5

# --- Memory ---
MEMORY_ENABLED=true
MEMORY_BACKEND=chroma

# --- Authentication (Optional) ---
AUTH_ENABLED=false
JWT_SECRET=change-this-to-a-random-secret

# --- Tools ---
TOOLS_ENABLED=true
