{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  // Only the Electron main/preload processes are compiled by tsc.
  // The renderer (src/App.tsx + services) is bundled to a browser-safe IIFE
  // by esbuild via the "build:renderer" script (see package.json).
  "include": ["src/main.ts", "src/preload.ts"],
  "exclude": ["node_modules", "dist", "release"]
}
