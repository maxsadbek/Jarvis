{
  "name": "jarvis-desktop",
  "version": "0.1.0",
  "description": "JARVIS AI Assistant - Windows Desktop Application",
  "main": "dist/main.js",
  "author": "JARVIS Team",
  "license": "MIT",
  "scripts": {
    "build:renderer": "esbuild src/App.tsx --bundle --outfile=dist/App.js --format=iife --platform=browser --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit",
    "build": "npm run typecheck && npm run build:renderer && tsc",
    "dev": "npm run build && concurrently -k \"tsc -w\" \"esbuild src/App.tsx --bundle --outfile=dist/App.js --format=iife --platform=browser --sourcemap --watch\" \"electron .\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "Jarvis",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "config/**/*",
      "public/**/*",
      "index.html",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Jarvis-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jarvis AI Assistant",
      "uninstallDisplayName": "Jarvis AI Assistant",
      "runAfterFinish": true,
      "installerIcon": "resources/icon.ico"
    },
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ]
  }
}
